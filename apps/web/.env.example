# --- Live browser analysis (default) -------------------------------------
# Nothing to configure. Detection, tracking and analytics run in the browser
# as soon as a video plays.

# --- Optional YOLO26 worker ----------------------------------------------
# Only set these if you are running the Python worker and want the
# higher-accuracy batch/stream pass. Leave unset for browser-only mode.
# NEXT_PUBLIC_WORKER_HTTP_BASE=http://localhost:8000
# NEXT_PUBLIC_WORKER_WS_BASE=ws://localhost:8000
# WORKER_URL=http://localhost:8000

# --- Optional GPT match briefing -----------------------------------------
# Server-only. Never expose this to the browser.
# Without a working key the insights card falls back to a built-in briefing
# generated from the same numbers, so the dashboard stays complete.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: route through an OpenAI-compatible gateway, Azure deployment, or a
# local stub. Defaults to https://api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com
