# Optional: point the dashboard at a YOLO26 worker.
# Leave unset on Vercel unless you have a public worker URL (Cloudflare Tunnel, GPU host, etc).
NEXT_PUBLIC_WORKER_HTTP_BASE=http://localhost:8000
NEXT_PUBLIC_WORKER_WS_BASE=ws://localhost:8000

# Server-side worker URL used by /api/health
WORKER_URL=http://localhost:8000
